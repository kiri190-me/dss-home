# 이 파일은 예시용이며 실제 값이 아닙니다. 실제 값은 .env.local(Git 추적 제외)에만 둡니다.

# ─── 사내 시스템(통합 로그인 포털) 주소 ──────────────────────────────
# 머리말 오른쪽 위 [사내 시스템] 버튼이 여기로 연결됩니다.
#   개발 : http://localhost:3100
#   배포 : NAS의 리버스 프록시 뒤 주소
#
# NEXT_PUBLIC_ 접두사가 없는 것은 의도한 것입니다 — 서버에서 링크를 만들 때만
# 쓰이므로 브라우저 번들에 넣을 이유가 없고, 이미지를 다시 빌드하지 않고
# 환경변수만 바꿔도 반영됩니다.
PORTAL_URL=http://localhost:3100

# ─── 데이터베이스 ─────────────────────────────────────────────────────
# 수리 의뢰와 고객사 링크가 들어갑니다.
#
# ⚠️ 이 DB는 **회사 밖**에 있습니다(사내 NAS가 아닙니다). 개인정보가 담기므로
#    사내 자료보다 더 조심해야 합니다 — 로그에 남기지 않고, 사내가 가져간 뒤
#    보관 기한이 지나면 지웁니다.
#
# 포트가 5436인 이유: A/S 시스템이 5432/5433, dss-auth가 5434를 이미 씁니다.
DATABASE_URL=postgresql://dss_home_app:CHANGE_ME@127.0.0.1:5436/dss_home_dev

# docker-compose.yml이 읽는 값. 위 DATABASE_URL의 비밀번호와 같아야 합니다.
DEV_POSTGRES_PASSWORD=CHANGE_ME

# ─── 사내와 주고받는 공유 비밀 ────────────────────────────────────────
# A/S 시스템이 /api/nas-sync/* 를 부를 때 제시하는 값입니다.
# 32자 이상. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# A/S 시스템 쪽 .env.local의 DSS_HOME_SYNC_SECRET 과 **같은 값**이어야 합니다.
#
# 이 열쇠로 새 의뢰를 읽고 고객사 링크를 심을 수 있지만, **사내망에는 닿을 수
# 없습니다** — 연결은 언제나 사내가 먼저 걸고 여기서 사내로 가는 길은 없습니다.
NAS_SYNC_SECRET=

# ─── 프록시 ───────────────────────────────────────────────────────────
# 우리 앞에 있는 **신뢰하는** 리버스 프록시 수. 기본 0.
# 속도 제한이 손님을 구분하는 근거입니다(자세한 판단은 lib/http/client-key.ts).
#
# ⚠️ 이 사이트는 외부 호스팅에 올라가고 대부분의 호스팅은 프록시 뒤이므로,
#    배포할 때 1로 바꿔야 할 가능성이 높습니다. 0으로 두면 뚫리지는 않고
#    대신 모두가 한 통을 쓰며, IP 해시도 남지 않습니다.
TRUSTED_PROXY_HOPS=0
